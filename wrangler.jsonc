{
  "name": "radar-beautyintel-work",
  "main": "./worker.js",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/products/numbuzin-no5-vitamin-toner/bubble.svg"
    ],
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "radar.beautyintel.work",
      "custom_domain": true
    }
  ]
}
